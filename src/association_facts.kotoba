        (string=? f "url-provenance") (option-some-of [:option :string] "official-korcham-net")
        (string=? f "established-date") (option-some-of [:option :string] "1895-11-10")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-10")
