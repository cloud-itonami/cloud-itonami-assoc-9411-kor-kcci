;; The KCCI source catalog, as Kotoba.
;;
;; GENERATED from data/datascript-tx.edn, which src/association/facts.cljc
;; reads as data. Both are the same catalog; this one reaches the Kotoba
;; oracle, wasm and both native ISAs, which the .cljc cannot.
;;
;; `:topic` is a SET in the source. A set has no order and `topic` is
;; indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every
;; field of every entry against the .cljc, so this file cannot drift from
;; the data without the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "kcci"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 15 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 15)) false))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "kcci.predecessor-seoul-chamber-1884")
        (string=? f "title") (option-some-of [:option :string] "KCCI's earliest predecessor, the Hanseong Chamber of Commerce (한성상업회의소), was established in 1884 -- the year KCCI's own chronology dates its institutional history from")
        (string=? f "association") (option-some-of [:option :string] "kcci")
        (string=? f "isic") (option-some-of [:option :string] "9411")
        (string=? f "country") (option-some-of [:option :string] "KOR")
        (string=? f "kind") (option-some-of [:option :string] "governance-program")
        (string=? f "url") (option-some-of [:option :string] "https://www.korcham.net/nCham/Service/Kcci/appl/History.asp")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-korcham-net")
        (string=? f "established-date") (option-some-of [:option :string] "1884")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-10")
        :else (option-none-of [:option :string]))

      (= i 1)
      (cond
        (string=? f "id") (option-some-of [:option :string] "kcci.commercial-conference-regulations-1895")
